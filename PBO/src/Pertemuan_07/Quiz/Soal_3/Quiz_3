package Pertemuan_07.Quiz.Soal_3; 

// Soal 3 - Sistem Transaksi Penjualan

import java.text.DecimalFormat;
import java.text.DecimalFormatSymbols;
import java.util.Scanner;

class Barang {
    private String kodeBarang;
    private String namaBarang;
    private double harga;
    private int stok;

    // Constructor dengan validasi harga > 0 dan stok awal tidak negatif
    public Barang(String kodeBarang, String namaBarang, double harga, int stok) {
        this.kodeBarang = kodeBarang;
        this.namaBarang = namaBarang;
        this.harga = (harga > 0) ? harga : 1000;
        this.stok = (stok >= 0) ? stok : 0;
    }

    // Getter untuk membaca data barang
    public String getKodeBarang() {
        return kodeBarang;
    }

    public String getNamaBarang() {
        return namaBarang;
    }

    public double getHarga() {
        return harga;
    }

    public int getStok() {
        return stok;
    }

    // Method tambahStok dengan validasi jumlah > 0
    public boolean tambahStok(int jumlah) {
        if (jumlah > 0) {
            this.stok += jumlah;
            return true;
        }
        return false;
    }

    // Method jualBarang dengan validasi jumlah > 0 dan tidak melebihi stok
    public boolean jualBarang(int jumlah) {
        if (jumlah > 0 && jumlah <= this.stok) {
            this.stok -= jumlah;
            return true;
        }
        return false;
    }

    // Method hitungTotal (Diskon 10% jika subtotal minimal Rp500.000)
    public double hitungTotal(int jumlah) {
        double subtotal = this.harga * jumlah;
        if (subtotal >= 500000) {
            return subtotal - (subtotal * 0.10);
        }
        return subtotal;
    }
}

public class quiz3 {

    // Helper untuk format angka rupiah bertitik (contoh: 150.000)
    public static String formatRupiah(double nilai) {
        DecimalFormatSymbols simbol = new DecimalFormatSymbols();
        simbol.setGroupingSeparator('.');
        DecimalFormat df = new DecimalFormat("#,###", simbol);
        return "Rp" + df.format(nilai);
    }

    public static void main(String[] args) {
        Scanner in = new Scanner(System.in);

        // Inisialisasi data awal barang (sesuai contoh di slide: Keyboard Rp150.000, stok awal 10 -> beli 4 sisa 6)
        Barang barang = new Barang("BRG01", "Keyboard", 150000, 10);

        while (true) {
            System.out.println("\n=== MENU TOKO ===");
            System.out.println("1. Tampilkan Barang");
            System.out.println("2. Tambah Stok");
            System.out.println("3. Beli Barang");
            System.out.println("4. Keluar");
            System.out.print("Pilih Menu (1-4): ");
            int menu = in.nextInt();

            if (menu == 1) {
                System.out.println("\n=== DATA BARANG ===");
                System.out.println("Kode Barang : " + barang.getKodeBarang());
                System.out.println("Nama Barang : " + barang.getNamaBarang());
                System.out.println("Harga       : " + formatRupiah(barang.getHarga()));
                System.out.println("Stok        : " + barang.getStok());

            } else if (menu == 2) {
                System.out.print("\nMasukkan jumlah stok tambahan: ");
                int tambah = in.nextInt();

                if (barang.tambahStok(tambah)) {
                    System.out.println("Stok berhasil ditambahkan! Stok sekarang: " + barang.getStok());
                } else {
                    System.out.println("Gagal! Jumlah tambah stok harus lebih dari 0.");
                }

            } else if (menu == 3) {
                System.out.print("\nMasukkan jumlah pembelian: ");
                int beli = in.nextInt();

                if (beli <= 0) {
                    System.out.println("Transaksi ditolak! Jumlah pembelian minimal 1.");
                } else if (beli > barang.getStok()) {
                    System.out.println("Transaksi ditolak! Jumlah pembelian melebihi stok tersedia (" + barang.getStok() + ").");
                } else {
                    double subtotal = barang.getHarga() * beli;
                    double totalBayar = barang.hitungTotal(beli);
                    double diskon = subtotal - totalBayar;

                    // Update stok lewat method valid
                    barang.jualBarang(beli);

                    System.out.println("\n=== STRUK PEMBELIAN ===");
                    System.out.println("Nama Barang : " + barang.getNamaBarang());
                    System.out.println("Harga       : " + formatRupiah(barang.getHarga()));
                    System.out.println("Jumlah      : " + beli);
                    System.out.println("Subtotal    : " + formatRupiah(subtotal));
                    if (diskon > 0) {
                        System.out.println("Diskon 10%  : " + formatRupiah(diskon));
                    }
                    System.out.println("Total Bayar : " + formatRupiah(totalBayar));
                    System.out.println("Sisa Stok   : " + barang.getStok());
                    System.out.println("Transaksi berhasil!");
                }

            } else if (menu == 4) {
                System.out.println("\nTerima kasih! Program selesai.");
                break;

            } else {
                System.out.println("Pilihan menu tidak valid!");
            }
        }

        in.close();
    }
}
